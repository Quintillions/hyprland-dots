#!/usr/bin/env bash
# Latin weekday / Roman date for Horologium (Waybar) and Tabula Obscura (Eww).
# Usage: latin-date [eww|waybar|plain]
set -u

roman() {
    local n=$1 out="" i
    local -a v=(1000 900 500 400 100 90 50 40 10 9 5 4 1)
    local -a s=(M CM D CD C XC L XL X IX V IV I)
    for i in "${!v[@]}"; do
        while (( n >= v[i] )); do out+=${s[i]}; (( n -= v[i] )); done
    done
    printf '%s' "$out"
}

weekdays=(SOLIS LUNAE MARTIS MERCURII IOVIS VENERIS SATURNI)
months=(IANUARII FEBRUARII MARTII APRILIS MAII IUNII IULII AUGUSTI SEPTEMBRIS OCTOBRIS NOVEMBRIS DECEMBRIS)

read -r wday day month year hour hhmm < <(date '+%w %-d %-m %Y %-H %H:%M')
dies="DIES ${weekdays[wday]}"
datum="$(roman "$day") ${months[month-1]} $(roman "$year")"
daypart=luna
(( hour >= 7 && hour < 19 )) && daypart=sol

case "${1:-plain}" in
    eww)
        jq -nc --arg dies "$dies" --arg datum "$datum" --arg time "$hhmm" --arg daypart "$daypart" \
            '{dies:$dies, datum:$datum, time:$time, daypart:$daypart}' ;;
    waybar)
        jq -nc --arg text "$dies · $datum" --arg tip "$(date '+%A, %-d %B %Y')" \
            '{text:$text, tooltip:$tip}' ;;
    *)
        printf '%s · %s\n' "$dies" "$datum" ;;
esac
