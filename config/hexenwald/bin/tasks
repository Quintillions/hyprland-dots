#!/usr/bin/env bash
# Memento Mori task list.
# Usage: tasks list|add <text>|toggle <id>|remove <id>|clear-done|prompt-add|prompt-edit <id>
# The prompt-* commands read text through rofi so nothing user-typed is ever interpolated into a shell string.
set -u
STATE_DIR=${HEXEN_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/hexenwald}
FILE=$STATE_DIR/tasks.json
mkdir -p "$STATE_DIR"
[ -s "$FILE" ] || echo '[]' >"$FILE"
save() { local t; t=$(mktemp "$FILE.XXXXXX") && cat >"$t" && mv "$t" "$FILE"; }

ask() {  # ask <label> [prefill]  -> text on stdout
    rofi -dmenu -p "$1" -filter "${2:-}" -theme hexenwald-prompt </dev/null
}

case "${1:-list}" in
    list) jq -c '.' "$FILE" ;;
    add)
        shift; text="$*"
        text=$(printf '%s' "$text" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
        [ -n "$text" ] || exit 0
        jq -c --arg t "$text" --arg id "$(date +%s%N)" '. + [{id:$id, text:$t, done:false}]' "$FILE" | save ;;
    toggle) jq -c --arg id "${2:-}" 'map(if .id==$id then .done=(.done|not) else . end)' "$FILE" | save ;;
    remove) jq -c --arg id "${2:-}" 'map(select(.id!=$id))' "$FILE" | save ;;
    prompt-add) text=$(ask "Nova nota") && [ -n "$text" ] && exec "$0" add "$text" ;;
    prompt-edit)
        old=$(jq -r --arg id "${2:-}" '.[]|select(.id==$id)|.text' "$FILE")
        [ -n "$old" ] || exit 0
        text=$(ask "Muta notam" "$old") || exit 0
        [ -n "$text" ] && jq -c --arg id "$2" --arg t "$text" 'map(if .id==$id then .text=$t else . end)' "$FILE" | save ;;
    clear-done) jq -c 'map(select(.done|not))' "$FILE" | save ;;
    *) echo "usage: tasks list|add <text>|toggle <id>|remove <id>|clear-done|prompt-add|prompt-edit <id>" >&2; exit 2 ;;
esac
